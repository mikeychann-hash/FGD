{
  "openapi": "3.1.0",
  "info": {
    "title": "FGD Internal API",
    "version": "1.0.0",
    "description": "Canonical REST entry points for bot lifecycle, progression, health, and Minecraft bridge status."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "Bot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "position": {
            "$ref": "#/components/schemas/Position"
          },
          "personalityTraits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "role",
          "status"
        ]
      },
      "Position": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "z": {
            "type": "number"
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "database": {
            "type": "string"
          },
          "redis": {
            "type": "string"
          },
          "minecraft": {
            "type": "string"
          },
          "npcEngine": {
            "type": "string"
          },
          "registry": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        }
      },
      "DeadLetterItem": {
        "type": "object",
        "properties": {
          "botId": {
            "type": "string"
          },
          "profile": {
            "type": "object"
          },
          "position": {
            "$ref": "#/components/schemas/Position"
          },
          "error": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check for all subsystems",
        "responses": {
          "200": {
            "description": "Subsystem status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/minecraft/status": {
      "get": {
        "summary": "Minecraft bridge / plugin heartbeat status",
        "responses": {
          "200": {
            "description": "Plugin heartbeat age and status"
          }
        }
      }
    },
    "/api/progression": {
      "get": {
        "summary": "Current progression status",
        "responses": {
          "200": {
            "description": "Status returned"
          }
        }
      }
    },
    "/api/progression/phase": {
      "get": {
        "summary": "Get current phase",
        "responses": {
          "200": {
            "description": "Phase info"
          }
        }
      },
      "put": {
        "summary": "Set progression phase",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phase": {
                    "type": "integer"
                  }
                },
                "required": [
                  "phase"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Phase updated"
          },
          "400": {
            "description": "Invalid phase"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/bots": {
      "get": {
        "summary": "List bots",
        "responses": {
          "200": {
            "description": "Bots",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "bots": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Bot"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      },
      "post": {
        "summary": "Create bot",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bot created"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/bots/{id}": {
      "get": {
        "summary": "Get bot details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bot"
          },
          "404": {
            "description": "Not found"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/bots/{id}/spawn": {
      "post": {
        "summary": "Spawn bot via Golden Path",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "position": {
                    "$ref": "#/components/schemas/Position"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Spawn request accepted"
          },
          "400": {
            "description": "Validation error"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/bots/{id}/despawn": {
      "post": {
        "summary": "Despawn bot",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Despawned"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/bots/spawn-all": {
      "post": {
        "summary": "Spawn all known bots",
        "responses": {
          "200": {
            "description": "Spawn-all dispatched"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/bots/dead-letter": {
      "get": {
        "summary": "List dead letter spawn failures",
        "responses": {
          "200": {
            "description": "Dead letter queue",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "queue": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DeadLetterItem"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/bots/dead-letter/retry": {
      "post": {
        "summary": "Retry dead-lettered spawns through the Golden Path",
        "responses": {
          "200": {
            "description": "Retry results"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/action": {
      "post": {
        "summary": "Dispatch an in-world action via UAF",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "botId": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "block": {
                    "type": "string"
                  },
                  "position": {
                    "": "#/components/schemas/Position"
                  }
                },
                "required": [
                  "botId",
                  "type"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Action accepted"
          },
          "400": {
            "description": "Validation error"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/bots/{id}/action": {
      "post": {
        "summary": "Dispatch action for a bot",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "block": {
                    "type": "string"
                  },
                  "position": {
                    "": "#/components/schemas/Position"
                  }
                },
                "required": [
                  "type"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Action accepted"
          },
          "400": {
            "description": "Validation error"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    }
  }
}