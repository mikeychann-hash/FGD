{
  "name": "aicraft-cluster-dashboard",
  "version": "2.1.0",
  "type": "module",
  "main": "server.js",
  "private": true,
  "license": "GPL-3.0",
  "description": "AICraft Federation unified admin and system dashboard with persistent backend and live monitoring.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron ./desktop/main.cjs --dev",
    "build:renderer": "vite build",
    "build:electron": "electron-builder",
    "build": "npm run build:renderer && npm run build:electron",
    "pack": "electron-builder --dir",
    "dist": "npm run build:renderer && electron-builder",
    "lint": "eslint src/ routes/ middleware/ tests/ desktop/renderer --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src/ routes/ middleware/ tests/ desktop/renderer --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.js\" \"routes/**/*.js\" \"middleware/**/*.js\" \"tests/**/*.js\" \"desktop/renderer/**/*.{ts,tsx}\"",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/integration",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:spawn-e2e": "set ADMIN_API_KEY=test-key && set LLM_API_KEY=test-key && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runTestsByPath tests/integration/spawn.e2e.test.js --passWithNoTests",
    "test:spawn-live": "node scripts/test_spawn_live.js",
    "policy:heal": "node scripts/policy_self_heal.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.4",
    "express": "^4.19.0",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "minecraft-data": "^3.100.0",
    "mineflayer": "^4.0.0",
    "mineflayer-auto-eat": "^3.3.6",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "moment": "^2.29.4",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0",
    "rcon-client": "^4.2.5",
    "redis": "^4.6.10",
    "socket.io": "^4.6.1",
    "socket.io-client": "^4.7.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "vec3": "^0.1.10",
    "ws": "^8.17.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@heroicons/react": "^2.0.18",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.5.0",
    "@vitejs/plugin-react": "^4.0.4",
    "ajv": "^8.12.0",
    "autoprefixer": "^10.4.15",
    "babel-jest": "^29.7.0",
    "concurrently": "^8.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^24.6.4",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "postcss": "^8.4.29",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.2.2",
    "vite": "^4.4.9",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.aicraft.fgd",
    "productName": "FGD Desktop",
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/dist/**/*",
      "server.js",
      "core_runtime.js",
      "npc_engine.js",
      "minecraft_bridge.js",
      "minecraft_bridge_mineflayer.js",
      "adapters/**/*",
      "core/**/*",
      "npc_engine/**/*",
      "routes/**/*",
      "src/**/*",
      "middleware/**/*",
      "security/**/*",
      "tasks/**/*",
      "data/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
