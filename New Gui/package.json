{
  "name": "minecraft-server-admin",
  "version": "1.0.0",
  "description": "Windows 11 desktop application for managing Minecraft servers",
  "main": "src/main/main.js",
  "author": "Minecraft Server Admin Team",
  "license": "MIT",
  "homepage": "https://github.com/minecraft-server-admin/minecraft-server-admin",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:main": "electron . --dev",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "electron-builder",
    "build:renderer": "vite build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "jest",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.4",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "rcon": "^1.0.3",
    "mineflayer": "^4.14.0",
    "axios": "^1.5.0",
    "chart.js": "^4.5.0",
    "chalk": "^4.1.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "electron": "^26.2.1",
    "electron-builder": "^24.6.4",
    "vite": "^4.4.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "typescript": "^5.2.2",
    "tailwindcss": "^3.3.3",
    "autoprefixer": "^10.4.15",
    "postcss": "^8.4.29",
    "@vitejs/plugin-react": "^4.0.4",
    "concurrently": "^8.2.1",
    "jest": "^29.6.4",
    "eslint": "^8.48.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.5.0",
    "@heroicons/react": "^2.0.18"
  },
  "build": {
    "appId": "com.minecraftserveradmin.app",
    "productName": "Minecraft Server Admin",
    "directories": {
      "output": "dist"
    },
  "files": [
    "dist-electron/**/*",
    "dist-react/**/*",
    "node_modules/**/*",
    "package.json",
    "src/main/**/*"
  ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "minecraft-server-admin",
      "repo": "minecraft-server-admin"
    }
  }
}
